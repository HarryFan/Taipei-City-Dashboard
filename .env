# Database Configuration
DB_DASHBOARD_USER=postgres
DB_DASHBOARD_PASSWORD=postgres
DB_DASHBOARD_DBNAME=dashboard
DB_DASHBOARD_PORT=5432

DB_MANAGER_USER=postgres
DB_MANAGER_PASSWORD=postgres
DB_MANAGER_DBNAME=dashboardmanager
DB_MANAGER_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Application Configuration
NODE_ENV=development
VITE_API_URL=http://localhost:8088
VITE_APP_TITLE=Taipei City Dashboard
VITE_APP_VERSION=1.0.0
VITE_MAPBOXTOKEN=your_mapbox_token
VITE_MAPBOXTILE=your_mapbox_tile

# Authentication
JWT_SECRET=your_jwt_secret
IDNO_SALT=your_idno_salt
ISSO_CLIENT_ID=your_isso_client_id
ISSO_CLIENT_SECRET=your_isso_client_secret
TAIPEIPASS_URL=https://your-taipeipass-url.com
ISSO_CLIENT_SCOPE=openid email profile

# Default Admin User
DASHBOARD_DEFAULT_USERNAME=admin
DASHBOARD_DEFAULT_Email=admin@example.com
DASHBOARD_DEFAULT_PASSWORD=admin123

# Database Sample Files
MANAGER_SAMPLE_FILE=dashboardmanager-demo.sql
DASHBOARD_SAMPLE_FILE=dashboard-demo.sql
